# Puerto en el que corre el servidor (Render lo asigna automáticamente en producción)
PORT=3000

# Conexión a MySQL (Railway) — usa el host y puerto del TCP Proxy público, no el interno
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Secreto para firmar los JWT de sesión
JWT_SECRET=

# Cloudinary — https://console.cloudinary.com/ (Dashboard, arriba a la derecha)
# Pega aquí tu Cloud Name, API Key y API Secret. El API Secret NUNCA debe ir al frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
